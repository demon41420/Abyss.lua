-- ================== KEY SYSTEM ==================
local KEY_STORAGE = "abyss_data.txt"
local KEY_LIFETIME = 24 * 60 * 60
local GIST_URL = "https://gist.githubusercontent.com/demon41420/482f645e463b4fc02c9e130d33abe685/raw/Keys.json"

local function loadKeysFromGist()
    local ok, result = pcall(function() return game:HttpGet(GIST_URL) end)
    if not ok or not result or #result < 10 then return nil end
    local ok2, decoded = pcall(function() return HttpService:JSONDecode(result) end)
    if not ok2 or not decoded then return nil end
    return decoded
end

local function getHWID()
    local ok, id = pcall(function() return game:GetService("RbxAnalyticsService"):GetClientId() end)
    if ok and id and #tostring(id) > 0 then return tostring(id) end
    return tostring(LocalPlayer.UserId) .. "_" .. tostring(game.PlaceId)
end

local function readData()
    if not readfile or not isfile then return nil end
    local ok, exists = pcall(function() return isfile(KEY_STORAGE) end)
    if not ok or not exists then return nil end
    local ok2, data = pcall(function() return readfile(KEY_STORAGE) end)
    if not ok2 or not data then return nil end
    local key, hwid, time = data:match("([^|]+)|([^|]+)|([^|]+)")
    if not key then return nil end
    return { key = key, hwid = hwid, time = tonumber(time) }
end

local function writeData(key, hwid, t)
    if not writefile then return end
    pcall(function() writefile(KEY_STORAGE, key .. "|" .. hwid .. "|" .. tostring(t)) end)
end

local function checkSaved(keysData)
    local data = readData()
    if not data then return false, "new" end
    local hwid = getHWID()
    if keysData then
        for _, mk in ipairs(keysData.master or {}) do
            if mk == data.key then return true, "master" end
        end
        for _, uk in ipairs(keysData.user or {}) do
            if uk == data.key and data.hwid == hwid then
                local elapsed = os.time() - (data.time or 0)
                if elapsed < KEY_LIFETIME then
                    return true, "user", KEY_LIFETIME - elapsed
                else
                    return false, "expired"
                end
            end
        end
    end
    return false, "invalid"
end

local function validateKey(key, keysData)
    if not keysData then return false, "no_gist" end
    local hwid = getHWID()
    for _, mk in ipairs(keysData.master or {}) do
        if mk == key then
            writeData(key, hwid, os.time())
            return true, "master"
        end
    end
    for _, uk in ipairs(keysData.user or {}) do
        if uk == key then
            local data = readData()
            if data and data.hwid and data.hwid ~= hwid and data.key == key then
                return false, "hwid_mismatch"
            end
            writeData(key, hwid, os.time())
            return true, "user"
        end
    end
    return false, "invalid"
end

