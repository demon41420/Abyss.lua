        StatusText.Text = "Gist недоступен. Проверь интернет."
        StatusText.TextColor3 = Color3.fromRGB(255, 80, 80); return
    end
    local ok, reason = validateKey(key, keysData)
    if ok then
        StatusText.Text = "Ключ принят! Загрузка Abyss..."
        StatusText.TextColor3 = Color3.fromRGB(0, 220, 100)
        accessGranted = true
        task.wait(0.6)
