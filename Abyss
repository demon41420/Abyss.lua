        elseif reason == "hwid_mismatch" then StatusText.Text = "Ключ активирован на другом устройстве."
        else StatusText.Text = "Неверный ключ." end
        StatusText.TextColor3 = Color3.fromRGB(255, 80, 80)
    end
end

