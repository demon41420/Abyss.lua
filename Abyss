local isStealing = false
local function attemptSteal()
    if not SE_CONFIG.AutoSteal or isStealing then return end
    local eggs = findEggs(); if #eggs == 0 then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local target = nil; local minD = math.huge
    for _,e in ipairs(eggs) do
        local p = e:IsA("Model") and e.PrimaryPart or e
        if p and p:IsA("BasePart") then
            local d = (hrp.Position - p.Position).Magnitude
            if SE_CONFIG.PrioritySniper then
                local rank = getRarityRank(getEggRarity(p))
                d = d - rank * 100
            end
            if d < minD then minD = d; target = p end
        end
    end
    if target and minD < 50 then
        isStealing = true
        hrp.CFrame = CFrame.new(target.Position); task.wait(0.1)
        local pr = target:FindFirstChildOfClass("ProximityPrompt")
        if pr then pr:InputHoldBegin(); task.wait(pr.HoldDuration or 0.5); pr:InputHoldEnd() end
        task.wait(0.3); isStealing = false
    end
end

local function returnToBase()
    if not SE_CONFIG.AutoReturn then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local sp = workspace:FindFirstChildOfClass("SpawnLocation")
    if sp then hrp.CFrame = sp.CFrame + Vector3.new(0,5,0) end
end

