local updateSABRisk = makeRiskMeter(sabTab, "РИСК БАНА (Steal a Brainrot)")
local function sabCalc()
    local t = 0; local count = 0
    for k, w in pairs(SAB_RISK) do if SAB_CONFIG[k] then t = t + w; count = count + 1 end end
    tabs["Steal a Brainrot"].counter.Text = tostring(count)
    return math.clamp(math.floor((t / SAB_MaxRisk) * 100), 0, 100)
end

