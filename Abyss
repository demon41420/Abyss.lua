    Fill.BorderSizePixel = 0
    Fill.Parent = BG
    local flc = Instance.new("UICorner"); flc.CornerRadius = UDim.new(1,0); flc.Parent = Fill

    local function getColor(p)
        if p<=20 then return Color3.fromRGB(0,220,100)
        elseif p<=45 then return Color3.fromRGB(255,200,0)
        elseif p<=70 then return Color3.fromRGB(255,120,0)
        else return Color3.fromRGB(255,40,40) end
    end
    local function getLabel(p)
        if p<=20 then return "НИЗКИЙ" elseif p<=45 then return "СРЕДНИЙ"
        elseif p<=70 then return "ВЫСОКИЙ" else return "КРИТИЧЕСКИЙ" end
    end

    return function(percent)
        local c = getColor(percent); local l = getLabel(percent)
        TweenService:Create(Fill,TweenInfo.new(0.3),{Size=UDim2.new(percent/100,0,1,0),BackgroundColor3=c}):Play()
        TweenService:Create(V,TweenInfo.new(0.3),{TextColor3=c}):Play()
        V.Text = percent.."% | "..l
    end
end

