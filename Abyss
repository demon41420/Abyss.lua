local function switchTab(name)
    for n, t in pairs(tabs) do
        if n == name then
            t.button.BackgroundColor3 = BRAND.Accent
            t.button.BackgroundTransparency = 0
            t.icon.TextColor3 = Color3.fromRGB(255,255,255)
            t.page.Visible = true
            t.page.Position = UDim2.new(0, 15, 0, 0)
            TweenService:Create(t.page, TweenInfo.new(0.25), { Position = UDim2.new(0, 0, 0, 0) }):Play()
        else
            t.button.BackgroundColor3 = Color3.fromRGB(28,24,42)
            t.button.BackgroundTransparency = 0.3
            t.icon.TextColor3 = Color3.fromRGB(200,200,220)
            t.page.Visible = false
        end
    end
    activeTab = name
end

local function setupTabClick(name)
