local eggESP = {}
local function findEggs()
    local e = {}
    for _,o in ipairs(workspace:GetDescendants()) do
        if (o:IsA("Model") or o:IsA("BasePart")) then
            local n = o.Name:lower()
            if n:find("egg") and not n:find("hatched") then table.insert(e,o) end
        end
    end
    return e
end

local function createEggESP(part)
    if eggESP[part] then return end
    local box = Drawing.new("Square"); box.Thickness = 1
    box.Color = Color3.fromRGB(255,200,0); box.Filled = false; box.Visible = false
    local lb = Drawing.new("Text"); lb.Size = 12; lb.Center = true
    lb.Outline = true; lb.Color = Color3.fromRGB(255,255,0); lb.Visible = false
    eggESP[part] = {box = box, label = lb}
end

local pESP = {}
local function createPlayerESP(player)
    if player == LocalPlayer or pESP[player] then return end
    local hl = Instance.new("Highlight")
    hl.FillColor = BRAND.Accent; hl.FillTransparency = 0.5
    hl.OutlineColor = BRAND.Accent2; hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Enabled = false
    hl.Adornee = player.Character or player.CharacterAdded:Wait()
    hl.Parent = player.Character
    player.CharacterAdded:Connect(function(c) hl.Adornee = c end)
    pESP[player] = hl
end
for _,p in ipairs(Players:GetPlayers()) do pcall(createPlayerESP, p) end
Players.PlayerAdded:Connect(function(p) pcall(createPlayerESP, p) end)
Players.PlayerRemoving:Connect(function(p) if pESP[p] then pESP[p]:Destroy(); pESP[p] = nil end end)

local notifiedEggs = {}
local function getEggRarity(p)
    local r = p:GetAttribute("Rarity") or p:GetAttribute("rarity")
    if r then return tostring(r) end
    local l = p.Name:lower()
    if l:find("unicorn") or l:find("divine") then return "Divine" end
    if l:find("eternal") then return "Eternal" end
    if l:find("secret") or l:find("kitsune") or l:find("dragon") then return "Secret" end
    if l:find("cosmic") then return "Cosmic" end
    if l:find("mythic") then return "Mythic" end
    if l:find("legendary") then return "Legendary" end
    if l:find("epic") then return "Epic" end
    if l:find("rare") then return "Rare" end
    return "Common"
end

